[Version]
Signature="$WINDOWS NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%Provider%
DriverVer=11/20/2026,0.1.0.0
CatalogFile=OpenUninstallerMonitor.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[DefaultInstall.NTamd64]
CopyFiles=DriverCopy

[DriverCopy]
OpenUninstallerMonitor.sys

[DefaultInstall.NTamd64.Services]
AddService=OpenUninstallerMonitor,,ServiceInstall

[ServiceInstall]
DisplayName=%ServiceName%
ServiceBinary=%12%\\OpenUninstallerMonitor.sys
ServiceType=2
StartType=3
ErrorControl=1
LoadOrderGroup="FSFilter Activity Monitor"
AddReg=Instances

[Instances]
HKR,"Instances","DefaultInstance",0x00000000,"OpenUninstaller Instance"
HKR,"Instances\\OpenUninstaller Instance","Altitude",0x00000000,"385210"
HKR,"Instances\\OpenUninstaller Instance","Flags",0x00010001,0

[Strings]
Provider="OpenUninstaller Project"
ServiceName="OpenUninstaller Monitor"
