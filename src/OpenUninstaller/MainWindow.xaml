<Window x:Class="OpenUninstaller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenUninstaller" Height="720" Width="1120" MinHeight="560" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#F2F4F7">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1" Padding="13">
   <DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="OpenUninstaller" FontSize="20" FontWeight="Bold" Foreground="#245B91"/><TextBlock Text="  软件卸载管理器" Margin="12,5,0,0" Foreground="#657386"/></StackPanel><TextBlock x:Name="StatusText" Text="就绪" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="8" BorderBrush="#D7DDE5" BorderThickness="0,1,0,0"><DockPanel><TextBlock x:Name="CountText" Text="0 个软件"/><ProgressBar x:Name="BusyBar" Width="150" Height="12" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Right"/></DockPanel></Border>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#D7DDE5" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,8">
    <DockPanel><StackPanel Orientation="Horizontal"><Button Content="刷新列表" Click="Refresh_Click"/><Button Content="卸载所选" Background="#2878C8" Foreground="White" Click="Uninstall_Click"/><Button Content="安装监控…" Click="Monitor_Click"/></StackPanel><TextBox x:Name="SearchBox" Width="260" Height="29" VerticalContentAlignment="Center" HorizontalAlignment="Right" ToolTip="搜索名称、发行商或版本" TextChanged="SearchBox_TextChanged"/></DockPanel>
   </Border>
   <DataGrid x:Name="AppsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" Background="White" BorderBrush="#D7DDE5" HeadersVisibility="Column" RowHeight="31" AlternatingRowBackground="#F7F9FC">
    <DataGrid.Columns><DataGridTextColumn Header="软件名称" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="*"/><DataGridTextColumn Header="发行商" Binding="{Binding Publisher}" Width="1.5*"/><DataGridTextColumn Header="安装日期" Binding="{Binding InstallDate}" Width="*"/><DataGridTextColumn Header="来源/架构" Binding="{Binding Architecture}" Width="*"/><DataGridTextColumn Header="安装位置" Binding="{Binding InstallLocation}" Width="2*"/></DataGrid.Columns>
   </DataGrid>
  </Grid>
 </DockPanel>
</Window>
