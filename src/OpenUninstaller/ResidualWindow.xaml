<Window x:Class="OpenUninstaller.ResidualWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="残留扫描与安全清理" Height="560" Width="900" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock x:Name="AppTitle" FontSize="17" FontWeight="Bold"/>
   <TextBlock Text="请逐项审核。文件将移动到隔离区；注册表卸载项会先导出备份。候选匹配不代表一定是残留。" TextWrapping="Wrap" Foreground="DarkGoldenrod" Margin="0,5"/>
   <StackPanel Orientation="Horizontal"><Button Content="全选" Click="SelectAll_Click"/><Button Content="清理所选（隔离/备份）" Background="#2878C8" Foreground="White" Click="Cleanup_Click"/></StackPanel>
  </StackPanel>
  <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False">
   <DataGrid.Columns><DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="风险" Binding="{Binding Risk}" Width="75"/><DataGridTextColumn Header="说明" Binding="{Binding Reason}" Width="2*"/><DataGridTextColumn Header="目标路径" Binding="{Binding Target}" Width="4*"/></DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
