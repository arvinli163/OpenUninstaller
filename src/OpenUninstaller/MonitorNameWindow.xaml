<Window x:Class="OpenUninstaller.MonitorNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建安装监控" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18" Width="360">
        <TextBlock Text="输入本次安装的软件名称：" Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox" Height="30" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="75"/>
            <Button Content="开始监控" IsDefault="True" MinWidth="90" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
